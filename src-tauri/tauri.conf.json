{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Check",
  "version": "1.2.1",
  "identifier": "es.adrian.tareas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Check",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "shortDescription": "Lista de tareas en un archivo Markdown",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDRUY4QjI3QzYwMEM0NkYKUldSdnhBREdKNHZ2ekJhNFN6OGZNZFdab3U1dUE2S2lZa1JsdHNvbWx0K2h5akxyYnE1V0hDaUMK",
      "endpoints": [
        "https://github.com/adrmoralf/check/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
